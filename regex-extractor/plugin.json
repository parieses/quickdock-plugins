{
  "id": "io.github.parieses.regex-extractor",
  "name": "正则提取工具",
  "version": "1.0.0",
  "description": "正则提取与替换：匹配高亮、分组捕获、反向引用替换（$1/$2）、一键复制结果",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "开发者日常",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "backend": {
    "runtime": "goja",
    "entry": "main.js"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 680,
    "height": 540
  },
  "commands": [
    {
      "id": "open-regex",
      "title": "正则提取工具",
      "keywords": [
        "regex",
        "regular",
        "extract",
        "正则",
        "提取",
        "匹配"
      ],
      "aliases": [
        "正则提取",
        "正则匹配",
        "regex提取",
        "re提取"
      ],
      "prefix": "/re",
      "title_i18n": {
        "zh-CN": "正则提取工具",
        "en-US": "Regex Extractor"
      }
    }
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true
  },
  "name_i18n": {
    "zh-CN": "正则提取工具",
    "en-US": "Regex Extractor"
  },
  "description_i18n": {
    "zh-CN": "正则提取与替换：匹配高亮、分组捕获、反向引用替换、一键复制",
    "en-US": "Regex extract & replace: match highlight, group capture, backreference replace, one-click copy."
  }
}