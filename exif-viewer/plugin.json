      "aliases": [
        "查看 EXIF",
        "图片信息",
        "照片元数据"
      ],
      "title_i18n": {
        "zh-CN": "EXIF 查看",
        "en-US": "EXIF Viewer"
      }
    }
  ],
  "name_i18n": {
    "zh-CN": "EXIF 查看",
    "en-US": "EXIF Viewer"
  },
  "description_i18n": {
    "zh-CN": "选择图片（JPEG/PNG）查看拍摄时间、相机/镜头、参数与 GPS 经纬度等 EXIF 信息",
    "en-US": "View EXIF metadata (capture time, camera/lens, params, GPS) of a JPEG/PNG image."
  }
