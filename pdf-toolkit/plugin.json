  "description_i18n": {
    "zh-CN": "PDF 处理工具箱：合并/拆分/压缩/加水印/提取图片，无需安装 Adobe Acrobat",
    "en-US": "PDF toolkit: merge/split/compress/watermark/extract images — no Adobe Acrobat required"
  },
  "author": "QuickDock",
  "icon": "icon.svg",
