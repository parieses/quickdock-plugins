{
  "id": "io.github.parieses.pdf-toolkit",
  "name": "PDF 工具箱",
  "name_i18n": {
    "zh-CN": "PDF 工具箱",
    "en-US": "PDF Toolkit"
  },
  "version": "1.0.0",
