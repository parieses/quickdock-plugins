{
  "id": "io.github.parieses.mindmap",
  "name": "思维导图",
  "version": "1.0.0",
  "description": "把 Markdown 大纲 / 缩进列表实时渲染成思维导图，自动分层配色、可点击折叠分支、支持缩放与导出 PNG / SVG",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "办公效率",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true
  },
  "backend": {
    "runtime": "none"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 900,
    "height": 640
  },
  "commands": [
    {
      "id": "mindmap",
      "title": "思维导图",
      "keywords": [
        "mindmap",
        "mind",
        "outline",
        "导图",
        "脑图",
        "思维导图",
        "大纲"
      ],
      "aliases": [
        "思维导图",
        "脑图",
        "大纲转导图",
        "siwei"
      ],
      "prefix": "/mm",
      "title_i18n": {
        "zh-CN": "思维导图",
        "en-US": "Mind Map"
      }
    }
  ],
  "name_i18n": {
    "zh-CN": "思维导图",
    "en-US": "Mind Map"
  },
  "description_i18n": {
    "zh-CN": "Markdown 大纲实时转思维导图，可折叠分支并导出 PNG / SVG",
    "en-US": "Turn a Markdown outline into a mind map in real time, collapse branches and export PNG/SVG."
  }
}
