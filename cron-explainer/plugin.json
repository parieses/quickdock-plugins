{
  "id": "io.github.parieses.cron-explainer",
  "name": "Crontab 解释器",
  "version": "1.0.0",
  "description": "解析 cron 表达式（含义/下次执行/小时分布），并可可视化生成表达式、实时预览下次执行时间",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "开发者日常",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "backend": {
    "runtime": "goja",
    "entry": "main.js"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 560,
    "height": 480
  },
  "commands": [
    {
      "id": "explain-cron",
      "title": "Crontab 解释器",
      "keywords": [
        "cron",
        "crontab",
        "schedule",
        "定时",
        "job"
      ],
      "aliases": [
        "cron表达式",
        "定时任务",
        "crond",
        "计划任务"
      ],
      "matchPattern": "^\\s*\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s*$",
      "prefix": "/cron",
      "acceptsInput": true,
      "title_i18n": {
        "zh-CN": "Crontab 解释器",
        "en-US": "Cron Explainer"
      }
    },
    {
      "id": "gen-cron",
      "title": "Cron 表达式生成",
      "keywords": [
        "cron",
        "generate",
        "builder",
        "生成",
        "构造",
        "定时器"
      ],
      "aliases": [
        "生成cron",
        "cron生成",
        "表达式生成",
        "定时生成"
      ],
      "prefix": "/genc",
      "title_i18n": {
        "zh-CN": "Cron 表达式生成",
        "en-US": "Generate Cron Expression"
      }
    }
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true
  },
  "name_i18n": {
    "zh-CN": "Crontab 解释器",
    "en-US": "Cron Explainer"
  },
  "description_i18n": {
    "zh-CN": "解析 cron 表达式（含义/下次执行/小时分布），并可可视化生成表达式、实时预览下次执行时间",
    "en-US": "Parse cron expressions (meaning / next runs / hour distribution), or build one visually with a live preview of upcoming runs."
  }
}