{
  "id": "io.github.parieses.jwt-decoder",
  "name": "JWT 解码器",
  "version": "1.0.1",
  "description": "解码 JWT Token，查看 Header/Payload，验证过期时间",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "开发者日常",
  "platforms": ["windows"],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "network": false,
    "filesystem": false,
    "clipboard": true
  },
  "commands": [
    {
      "id": "decode-jwt",
      "title": "JWT 解码器",
      "keywords": [
        "jwt",
        "token",
        "decode",
        "解码",
        "jwt解码"
      ],
      "aliases": [
        "jwt解码",
        "token解码"
      ],
      "prefix": "/jwt",
      "matchPattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
      "acceptsInput": true,
      "title_i18n": {
        "zh-CN": "JWT 解码器",
        "en-US": "JWT Decoder"
      }
    }
  ],
  "backend": {
    "runtime": "goja",
    "entry": "main.js"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html"
  },
  "name_i18n": {
    "zh-CN": "JWT 解码器",
    "en-US": "JWT Decoder"
  },
  "description_i18n": {
    "zh-CN": "解码 JWT Token，查看 Header/Payload，验证过期时间",
    "en-US": "Decode JWT tokens, inspect Header/Payload, and verify expiration."
  },
  "changelog": "## v1.0.1\n\n- 图标改用统一 64 网格满幅圆角贴片 + 白色图形，线宽归一\n- 新增浅色主题图标 `icon.light.svg`，随应用主题自动切换\n\n## v1.0.0\n\n- 解码 JWT Token，查看 Header/Payload，验证过期时间"
}
