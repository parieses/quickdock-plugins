{
  "id": "io.github.parieses.git-browser",
  "name": "Git 仓库浏览器",
  "version": "0.1.1",
  "description": "只读浏览 Git 仓库：本地（HEAD 分支/提交/工作区状态/分支，可选目录）与远程公开仓库（owner/repo，GitHub API 查分支/提交/star）",
  "author": "QuickDock",
  "category": "开发者日常",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "icon": "icon.svg",
  "backend": {
    "runtime": "native",
    "entry": "git-browser",
    "args": []
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 720,
    "height": 620
  },
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "filesystem": true
  },
  "commands": [
    {
      "id": "open",
      "title": "Git 仓库浏览器",
      "keywords": [
        "git",
        "repo",
        "commit",
        "branch",
        "仓库",
        "提交",
        "分支",
        "日志"
      ],
      "aliases": [
        "git 浏览",
        "仓库浏览",
        "查看提交"
      ],
      "title_i18n": {
        "zh-CN": "Git 仓库浏览器",
        "en-US": "Git Repository Browser"
      }
    }
  ],
  "name_i18n": {
    "zh-CN": "Git 仓库浏览器",
    "en-US": "Git Repository Browser"
  },
  "description_i18n": {
    "zh-CN": "只读浏览 Git 仓库：本地（HEAD 分支/提交/工作区状态/分支，可选目录）与远程公开仓库（owner/repo，GitHub API 查分支/提交/star）",
    "en-US": "Read-only Git browser: local repos (HEAD/commits/status/branches, folder picker) and public remote repos (owner/repo via GitHub API)."
  }
}