{
  "id": "io.github.parieses.compare",
  "name": "对比工具",
  "version": "0.2.2",
  "description": "文件/图片对比（元数据 + 图片预览 + 文本内容差异）与文本块逐行 Diff 合二为一",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "开发者日常",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "backend": {
    "runtime": "goja",
    "entry": "main.js"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 720,
    "height": 560
  },
  "commands": [
    {
      "id": "open-file-compare",
      "title": "文件/图片对比",
      "keywords": [
        "file",
        "compare",
        "diff",
        "文件",
        "对比文件",
        "图片对比",
        "文件差异"
      ],
      "aliases": [
        "文件对比",
        "图片对比",
        "文件差异"
      ],
      "prefix": "/fc",
      "title_i18n": {
        "zh-CN": "文件/图片对比",
        "en-US": "Compare Files/Images"
      }
    },
    {
      "id": "open-diff",
      "title": "Diff 文本对比",
      "keywords": [
        "diff",
        "compare",
        "对比",
        "差异"
      ],
      "aliases": [
        "文本对比",
        "差异对比",
        "diff对比"
      ],
      "prefix": "/diff",
      "title_i18n": {
        "zh-CN": "Diff 文本对比",
        "en-US": "Diff Text"
      }
    }
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true,
    "filesystem": true
  },
  "name_i18n": {
    "zh-CN": "对比工具",
    "en-US": "Compare Tool"
  },
  "description_i18n": {
    "zh-CN": "文件/图片对比（元数据 + 图片预览 + 文本内容差异）与文本块逐行 Diff 合二为一",
    "en-US": "File/image comparison (metadata + preview + text diff) plus line-by-line text diff in one tool."
  }
}
