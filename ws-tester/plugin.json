      }
    }
  ],
  "name_i18n": {
    "zh-CN": "WebSocket 测试",
    "en-US": "WebSocket Tester"
  },
  "description_i18n": {
    "zh-CN": "连接 ws/wss 服务，发送消息并实时查看返回的帧，支持多连接与历史",
