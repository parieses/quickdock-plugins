{
  "id": "io.github.parieses.crypto-toolbox",
  "name": "密码与加密工具箱",
  "version": "1.0.0",
  "description": "随机密码 / 口令生成（字符集可配、熵值与强度评估）＋ AES-GCM / AES-CBC 加解密 ＋ RSA-OAEP 密钥对与加解密 ＋ PBKDF2 密钥派生，全部在本机完成，不联网、不上传",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "安全工具",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true
  },
  "backend": {
    "runtime": "none"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 680,
    "height": 620
  },
  "commands": [
    {
      "id": "gen-password",
      "title": "生成随机密码",
      "keywords": [
        "password",
        "passwd",
        "pwd",
        "密码",
        "随机",
        "强密码",
        "generate"
      ],
      "aliases": [
        "密码生成",
        "随机密码",
        "强密码",
        "生成密码",
        "mm"
      ],
      "prefix": "/pwd",
      "matchPattern": "\\d{1,3}",
      "acceptsInput": true,
      "title_i18n": {
        "zh-CN": "生成随机密码",
        "en-US": "Generate Random Password"
      }
    },
    {
      "id": "crypto-toolbox",
      "title": "密码与加密工具箱",
      "keywords": [
        "crypto",
        "encrypt",
        "decrypt",
        "aes",
        "rsa",
        "加密",
        "解密",
        "加解密",
        "pbkdf2"
      ],
      "aliases": [
        "加解密",
        "加密工具箱",
        "AES加密",
        "RSA加密",
        "密码工具箱"
      ],
      "prefix": "/crypto",
      "title_i18n": {
        "zh-CN": "密码与加密工具箱",
        "en-US": "Crypto Toolbox"
      }
    }
  ],
  "name_i18n": {
    "zh-CN": "密码与加密工具箱",
    "en-US": "Password & Crypto Toolbox"
  },
  "description_i18n": {
    "zh-CN": "随机密码/口令生成 + AES/RSA 加解密 + PBKDF2 派生，全部本机运算",
    "en-US": "Random password & passphrase generation, AES/RSA encryption, PBKDF2 derivation. All local, nothing leaves your machine."
  }
}
