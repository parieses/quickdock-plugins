    "windows",
    "darwin",
    "linux"
  ],
  "icon": "icon.svg",
  "backend": {
    "runtime": "native",
    "entry": "speed-test",
    "args": []
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 820,
    "height": 560
  },
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "network": true
  },
