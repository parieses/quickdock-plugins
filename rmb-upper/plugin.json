{
  "id": "io.github.parieses.rmb-upper",
  "name": "人民币大写",
  "version": "0.1.0",
  "description": "数字金额转中文大写（壹贰叁…），财务报销、开票、合同的刚需小工具",
  "author": "QuickDock",
  "icon": "icon.svg",
  "category": "办公效率",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "clipboard": true
  },
  "backend": {
    "runtime": "none"
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 520,
    "height": 420
  },
  "commands": [
    {
      "id": "rmb-upper",
      "title": "人民币大写转换",
      "keywords": [
        "rmb",
        "人民币",
        "大写",
        "金额",
        "财务",
        "发票",
        "报销",
        "capital"
      ],
      "aliases": [
        "金额大写",
        "人民币大写",
        "数字转大写",
        "发票大写"
      ],
      "prefix": "/rmb",
      "matchPattern": "^\\d+(\\.\\d{1,2})?$",
      "acceptsInput": true,
      "title_i18n": {
        "zh-CN": "人民币大写转换",
        "en-US": "RMB Capital Amount"
      }
    }
  ],
  "name_i18n": {
    "zh-CN": "人民币大写",
    "en-US": "RMB Capital Amount"
  },
  "description_i18n": {
    "zh-CN": "数字金额转中文大写（壹贰叁…），财务报销、开票、合同的刚需小工具",
    "en-US": "Convert numeric amounts to Chinese capital form, as required on invoices and contracts."
  }
}
