{
  "id": "io.github.parieses.lan-scanner",
  "name": "局域网扫描",
  "version": "0.1.2",
  "description": "扫描同网段存活设备，显示 IP、主机名、MAC 地址与开放端口，自动识别本机网段（枚举失败时反推出网 IP 网段兜底）",
  "author": "QuickDock",
  "category": "网络工具",
  "platforms": [
    "windows"
  ],
  "icon": "icon.svg",
  "backend": {
    "runtime": "native",
    "entry": "lan-scanner",
    "args": []
  },
  "frontend": {
    "enabled": true,
    "entry": "frontend/index.html",
    "width": 860,
    "height": 620
  },
  "capabilities": [
    "command",
    "frontend"
  ],
  "permissions": {
    "network": true
  },
  "commands": [
    {
      "id": "scan",
      "title": "局域网设备扫描",
      "keywords": [
        "lan",
        "局域网",
        "扫描",
        "设备",
        "arp",
        "mac",
        "内网",
        "scan"
      ],
      "aliases": [
        "局域网扫描",
        "内网扫描",
        "设备扫描",
        "扫描局域网"
      ],
      "title_i18n": {
        "zh-CN": "局域网设备扫描",
        "en-US": "LAN Device Scanner"
      }
    }
  ],
  "name_i18n": {
    "zh-CN": "局域网扫描",
    "en-US": "LAN Scanner"
  },
  "description_i18n": {
    "zh-CN": "扫描同网段存活设备，显示 IP、主机名、MAC 地址与开放端口，自动识别本机网段",
    "en-US": "Scan the local subnet for live devices, showing IP, hostname, MAC address and open ports. Auto-detects your subnet."
  }
}
